#!/usr/bin/env bash
#
# xcodex - 通过代理运行 OpenAI Codex CLI 的包装脚本
#
# 用法:
#   xcodex [选项] -- [codex 原生参数...]
#   xcodex "写一个快速排序"                 # 直接把参数透传给 codex
#   xcodex --port 7890 "帮我重构这个函数"
#   xcodex --no-proxy "本地任务，不走代理"
#   xcodex --check                          # 仅测试代理连通性，不运行 codex
#   xcodex --yolo "帮我重构所有文件"        # 直接进入 yolo(全自动)模式，跳过确认
#   xcodex --no-yolo "普通任务"             # 明确不进入 yolo 模式，跳过提示
#
# 环境变量 (可写进 ~/.zshrc / ~/.bashrc 做默认值):
#   CODEXX_PROXY_HOST   默认代理主机，默认 127.0.0.1
#   CODEXX_PROXY_PORT   默认代理端口，默认 7897
#   CODEXX_PROXY_TYPE   http | socks5 | socks5h，默认自动检测(先 socks5，再回退 http)
#   CODEXX_NO_PROXY     默认 NO_PROXY 列表
#   CODEXX_MODEL        默认传给 codex 的 --model 参数（可选）
#   CODEXX_YOLO         设为 1 等价于始终传 --yolo，自动进入 yolo 模式
#
# 设计要点:
#   1. 代理变量只在本脚本及其子进程(即 codex 进程)生效，不污染当前交互 shell。
#   2. 大小写代理变量都设置，兼容不同工具的读取习惯。
#   3. 默认设置 NO_PROXY，避免本地/内网请求被错误代理。
#   4. 运行前做一次轻量连通性检测，代理不可达时给出清晰提示而不是让 codex 卡死。
#   5. 支持 --no-proxy 直接不设代理运行；支持自定义端口/协议；其余参数原样透传给 codex。
#   6. 启动时询问是否进入 yolo(全自动)模式；--yolo/-y 跳过询问直接进入，--no-yolo 跳过询问不进入。

set -eo pipefail

CMD=$(basename "$0")

# ---------- 默认配置 ----------
PROXY_HOST="${CODEXX_PROXY_HOST:-127.0.0.1}"
PROXY_PORT="${CODEXX_PROXY_PORT:-7897}"
PROXY_TYPE="${CODEXX_PROXY_TYPE:-socks5}"     # http | socks5 | socks5h
PROXY_TYPE_EXPLICIT=0                        # 1 = 用户通过 --type 显式指定了协议
NO_PROXY_LIST="${CODEXX_NO_PROXY:-localhost,127.0.0.1,::1}"
DEFAULT_MODEL="${CODEXX_MODEL:-}"
USE_PROXY=1
CHECK_ONLY=0
# -1: 未指定(启动时询问), 0: 不进入 yolo, 1: 进入 yolo
YOLO_MODE=-1
if [[ "${CODEXX_YOLO:-}" == "1" ]]; then
  YOLO_MODE=1
fi
EXTRA_ARGS=()

# ---------- 参数解析 ----------
while [[ $# -gt 0 ]]; do
  case "$1" in
    --host)
      PROXY_HOST="$2"; shift 2 ;;
    --port)
      PROXY_PORT="$2"; shift 2 ;;
    --type)
      PROXY_TYPE="$2"; PROXY_TYPE_EXPLICIT=1; shift 2 ;;      # http 或 socks5h
    --no-proxy)
      USE_PROXY=0; shift ;;
    --check)
      CHECK_ONLY=1; shift ;;
    --model)
      DEFAULT_MODEL="$2"; shift 2 ;;
    --yolo|-y)
      YOLO_MODE=1; shift ;;
    --no-yolo)
      YOLO_MODE=0; shift ;;
    --)
      shift
      EXTRA_ARGS+=("$@")
      break ;;
    -h|--help)
      sed -n '/^#/p; /^[^#]/q' "$0" | head -n -1
      exit 0 ;;
    *)
      EXTRA_ARGS+=("$1"); shift ;;
  esac
done

# ---------- 检查 codex 是否已安装 ----------
if ! command -v codex >/dev/null 2>&1; then
  echo "[$CMD] 未找到 codex 命令，请先安装: npm install -g @openai/codex" >&2
  exit 1
fi

PROXY_URL="${PROXY_TYPE}://${PROXY_HOST}:${PROXY_PORT}"

# ---------- 代理连通性检测 ----------
# 用指定协议尝试一次，成功返回 0，失败返回 1
_try_proxy() {
  local url="$1"
  curl -x "${url}" -s -m 5 -o /dev/null -w "%{http_code}" https://api.openai.com/ 2>/dev/null \
    | grep -qE '^[0-9]{3}$'
}

check_proxy() {
  # 若用户显式指定了 --type，只尝试该协议
  if [[ "$PROXY_TYPE_EXPLICIT" -eq 1 ]]; then
    echo "[$CMD] 检测代理 ${PROXY_URL} 是否可用..."
    if _try_proxy "${PROXY_URL}"; then
      echo "[$CMD] 代理可用 ✔"
      return 0
    else
      echo "[$CMD] 代理不可达: ${PROXY_URL}" >&2
      echo "[$CMD] 请确认本地代理软件(Clash/V2Ray等)已启动，且端口/协议正确。" >&2
      return 1
    fi
  fi

  # 自动检测：先尝试 socks5，再回退到 http
  local socks5_url="socks5://${PROXY_HOST}:${PROXY_PORT}"
  local http_url="http://${PROXY_HOST}:${PROXY_PORT}"

  echo "[$CMD] 检测代理 ${socks5_url} 是否可用..."
  if _try_proxy "${socks5_url}"; then
    echo "[$CMD] 代理可用 (socks5) ✔"
    PROXY_TYPE="socks5"
    PROXY_URL="${socks5_url}"
    return 0
  fi

  echo "[$CMD] socks5 不可达，尝试回退到 http 代理 ${http_url}..."
  if _try_proxy "${http_url}"; then
    echo "[$CMD] 代理可用 (http) ✔"
    PROXY_TYPE="http"
    PROXY_URL="${http_url}"
    return 0
  fi

  echo "[$CMD] 代理不可达 (已尝试 socks5 和 http): ${PROXY_HOST}:${PROXY_PORT}" >&2
  echo "[$CMD] 请确认本地代理软件(Clash/V2Ray等)已启动，且端口/协议正确。" >&2
  return 1
}

if [[ "$USE_PROXY" -eq 1 ]]; then
  if ! check_proxy; then
    exit 1
  fi
fi

if [[ "$CHECK_ONLY" -eq 1 ]]; then
  exit 0
fi

# ---------- yolo 模式确认 ----------
if [[ "$YOLO_MODE" -eq -1 ]]; then
  echo "⚡ [$CMD] 是否以 yolo(全自动)模式启动 codex？"
  echo "    yolo 模式下 codex 将自动执行所有操作，无需逐步确认。"
  echo "    当前目录: $(pwd)"
  read -r -p "    进入 yolo 模式吗？[y/N] " reply
  case "$reply" in
    [yY][eE][sS]|[yY]) YOLO_MODE=1 ;;
    *) YOLO_MODE=0 ;;
  esac
fi

# ---------- 组装 codex 参数 ----------
CODEX_ARGS=()
if [[ "$YOLO_MODE" -eq 1 ]]; then
  CODEX_ARGS+=(--approval-policy auto)
fi
if [[ -n "$DEFAULT_MODEL" ]]; then
  CODEX_ARGS+=(--model "$DEFAULT_MODEL")
fi
if [[ "${#EXTRA_ARGS[@]}" -gt 0 ]]; then
  CODEX_ARGS+=("${EXTRA_ARGS[@]}")
fi

# ---------- 运行 ----------
if [[ "$USE_PROXY" -eq 1 ]]; then
  echo "[$CMD] 使用代理 ${PROXY_URL} 启动 codex..."
  env \
    http_proxy="${PROXY_URL}" \
    https_proxy="${PROXY_URL}" \
    HTTP_PROXY="${PROXY_URL}" \
    HTTPS_PROXY="${PROXY_URL}" \
    all_proxy="${PROXY_URL}" \
    ALL_PROXY="${PROXY_URL}" \
    no_proxy="${NO_PROXY_LIST}" \
    NO_PROXY="${NO_PROXY_LIST}" \
    codex "${CODEX_ARGS[@]}"
else
  echo "[$CMD] 不使用代理，直接启动 codex..."
  env -u http_proxy -u https_proxy -u HTTP_PROXY -u HTTPS_PROXY -u all_proxy -u ALL_PROXY \
    codex "${CODEX_ARGS[@]}"
fi
